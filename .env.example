# SSH & PowerShell Server Configuration Template
# Renomeie este arquivo para .env e preencha com seus dados de acesso.

# Modo de conexao padrao: ssh (para servidores Linux/macOS) ou powershell (para dominio Windows usando WinRM/Invoke-Command)
CONNECTION_MODE=ssh

# Dados de conexao (usados por ambos os modos, ssh ou powershell)
SSH_HOST=10.0.0.7
SSH_PORT=22
SSH_USERNAME=<YOUR_USERNAME>
SSH_PASSWORD=

# Chave SSH Opcional (se nao usar senha, apenas para modo SSH)
# SSH_KEY_PATH=C:\caminho\para\sua\chave_id_rsa
# SSH_KEY_PASSPHRASE=sua_senha_da_chave

# Caminho para logs internos do Servidor
SSH_MCP_LOG=C:\ssh-mcp\logs\ssh-mcp.log
